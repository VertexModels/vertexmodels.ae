1:[["$","div",null,{"id":"top"}],["$","header",null,{"className":"site-header","children":[["$","a",null,{"href":"/","className":"brand","aria-label":"Vertex Models home","children":[["$","span",null,{"className":"brand-mark","children":["$","img",null,{"src":"/images/vertex-mark.png","alt":""}]}],["$","span",null,{"children":["VERTEX",["$","span",null,{"className":"brand-sub","children":"MODELS"}]]}]]}],["$","nav",null,{"className":"desktop-nav","aria-label":"Main navigation","children":[["$","a",null,{"href":"/services","children":"Services"}],["$","a",null,{"href":"/studio","children":"Studio"}],["$","a",null,{"href":"/#process","children":"Our process"}]]}],["$","a",null,{"href":"/start-a-project","className":"header-contact","children":["Start a project ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}],["$","details",null,{"className":"mobile-nav","children":[["$","summary",null,{"children":["Menu ",["$","span",null,{"children":"＋"}]]}],["$","nav",null,{"aria-label":"Mobile navigation","children":[["$","a",null,{"href":"/services","children":"Services"}],["$","a",null,{"href":"/studio","children":"Studio"}],["$","a",null,{"href":"/#process","children":"Our process"}],["$","a",null,{"href":"/faqs","children":"FAQs"}],["$","a",null,{"href":"/start-a-project","children":"Start a project"}]]}]]}]]}],["$","main",null,{"id":"main","className":"expansion","children":[["$","header",null,{"className":"editorial-intro","children":[["$","span",null,{"className":"section-index","children":"BEFORE WE BEGIN"}],["$","h1",null,{"children":["Good questions.",["$","br",null,{}],["$","em",null,{"children":"Clear answers."}]]}],["$","p",null,{"children":"A few things to know about commissioning a model or a bespoke piece. Your quotation will set out the details specific to your project."}]]}],["$","div",null,{"className":"faq-layout","children":[["$","nav",null,{"className":"faq-jump","aria-label":"Question categories","children":[["$","span",null,{"className":"section-index","children":"ON THIS PAGE"}],[["$","a","starting",{"href":"#starting","children":[["$","span",null,{"children":["0",1]}],"Starting a project"]}],["$","a","design",{"href":"#design","children":[["$","span",null,{"children":["0",2]}],"Design & making"]}],["$","a","delivery",{"href":"#delivery","children":[["$","span",null,{"children":["0",3]}],"Delivery & handover"]}]]]}],["$","div",null,{"children":[["$","section","starting",{"className":"faq-group","id":"starting","children":[["$","h2",null,{"children":"Starting a project"}],["$","$L16",null,{"items":[{"question":"What should I send with an enquiry?","answer":"Start with a short description of the project, its purpose, approximate size and required date. Add drawings, dimensions, reference images or a link to available files. If some details are undecided, tell us what you know and we can help define the next steps."},{"question":"Can you help if I only have an idea?","answer":"Yes. We can discuss the concept and the design work needed before fabrication. Design development, review stages and deliverables are defined in the quotation."},{"question":"How much does a model or fabrication project cost?","answer":"Cost depends on size, complexity, level of detail, materials, quantity, finish and delivery requirements. We quote against an agreed scope instead of using a single price per size."},{"question":"How long will it take?","answer":"The programme depends on the scope, material availability, production process and review stages. Share your required date at the start so feasibility and milestones can be confirmed in the quotation."}]}]]}],["$","section","design",{"className":"faq-group","id":"design","children":[["$","h2",null,{"children":"Design & making"}],["$","$L16",null,{"items":[{"question":"How do we choose the model scale?","answer":"Scale balances the overall footprint with the details you want people to see. We consider the project dimensions, available display space, viewing distance and transport requirements before proposing a scale."},{"question":"Can you use our existing CAD or 3D files?","answer":"Yes. Tell us which file formats you have and the intended output. Files are reviewed for suitability; any rebuilding or preparation is included in the agreed scope."},{"question":"Can lighting, interiors and landscaping be included?","answer":"Yes. Their extent, detail and finish are defined as part of the brief. For a physical model, the quotation should state exactly which elements are included."},{"question":"What happens if the design changes?","answer":"Let us know as early as possible. Changes after approval may affect production, materials, cost and timing. Any effect is agreed in writing before the revised work proceeds."},{"question":"Can the project remain confidential?","answer":"Tell us about confidentiality requirements before sharing restricted material. We can agree a suitable information-sharing approach and discuss an NDA where needed. Portfolio use should be agreed for the commission."}]}]]}],"$L17"]}]]}],"$L18"]}],"$L19"]
17:["$","section","delivery",{"className":"faq-group","id":"delivery","children":[["$","h2",null,{"children":"Delivery & handover"}],["$","$L16",null,{"items":[{"question":"Can you include a base, cover or transport case?","answer":"These can be considered with the model. The dimensions, finish, protection and handling requirements need to be specified so they can be included in the quotation."},{"question":"Can you arrange installation?","answer":"Installation and delivery can be planned within the project scope. Share the destination, access dimensions, venue requirements and display position before the design is finalised."},{"question":"What are the payment terms?","answer":"The payment schedule is stated in your quotation or agreement, together with the scope and programme. Production begins once the agreed prerequisites, approvals and initial payment have been received."},{"question":"How do I care for the finished model?","answer":"Keep it protected from dust, impact, direct sunlight, moisture and excessive heat. Handling, cleaning and any lighting instructions should follow the guidance supplied for the particular model and materials."}]}]]}]
