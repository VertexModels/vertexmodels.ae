1:[[["$","link","css:/_next/static/css/terms.DRhk0da2.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/_next/static/css/terms.DRhk0da2.css","data-rsc-css-href":"/_next/static/css/terms.DRhk0da2.css"}],"$undefined"],[["$","div",null,{"id":"top"}],["$","header",null,{"className":"site-header","children":[["$","a",null,{"href":"/","className":"brand","aria-label":"Vertex Models home","children":[["$","span",null,{"className":"brand-mark","children":["$","img",null,{"src":"/images/vertex-mark.png","alt":""}]}],["$","span",null,{"children":["VERTEX",["$","span",null,{"className":"brand-sub","children":"MODELS"}]]}]]}],["$","nav",null,{"className":"desktop-nav","aria-label":"Main navigation","children":[["$","a",null,{"href":"/services","children":"Services"}],["$","a",null,{"href":"/studio","children":"Studio"}],["$","a",null,{"href":"/#process","children":"Our process"}]]}],["$","a",null,{"href":"/start-a-project","className":"header-contact","children":["Start a project ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}],["$","details",null,{"className":"mobile-nav","children":[["$","summary",null,{"children":["Menu ",["$","span",null,{"children":"＋"}]]}],["$","nav",null,{"aria-label":"Mobile navigation","children":[["$","a",null,{"href":"/services","children":"Services"}],["$","a",null,{"href":"/studio","children":"Studio"}],["$","a",null,{"href":"/#process","children":"Our process"}],["$","a",null,{"href":"/faqs","children":"FAQs"}],["$","a",null,{"href":"/start-a-project","children":"Start a project"}]]}]]}]]}],["$","main",null,{"id":"main","className":"terms-page","children":[["$","header",null,{"className":"terms-heading","children":[["$","a",null,{"className":"terms-back","href":"/","children":"← Back to the studio"}],["$","span",null,{"className":"section-index","children":"WEBSITE & ENQUIRIES"}],["$","h1",null,{"children":["Your",["$","br",null,{}],["$","em",null,{"children":"privacy."}]]}],["$","p",null,{"children":"How information is handled when you visit or get in touch."}],["$","div",null,{"className":"terms-meta","children":["$","time",null,{"dateTime":"2026-09-29","children":"Updated 29 September 2026"}]}]]}],["$","div",null,{"className":"terms-sections","children":[[["$","section","Website visits",{"id":"$undefined","children":[["$","span",null,{"className":"terms-number","children":"01"}],["$","h2",null,{"children":"Website visits"}],["$","p",null,{"children":"This website presents our portfolio and invites enquiries. It has no customer account, online checkout or file-upload form. The project brief, collaboration and feedback forms prepare text in your browser for your review. Entering or reviewing text does not submit it. You can download it or send it from your email application. Where a direct-send option is available, clicking Send enquiry submits it through our delivery service as described below. We do not store enquiries in a website database. Closing or reloading the page clears the form state. Optional Google Analytics is described below. We have not added advertising pixels. Our hosting provider, OpenAI’s ChatGPT Sites and its infrastructure providers, may process technical request information such as IP address, browser information and security logs to deliver and protect the site. Their platform may also use cookies or similar technologies for hosting, security or platform features."}],false,false]}],["$","section","Forms and feedback",{"id":"forms","children":[["$","span",null,{"className":"terms-number","children":"02"}],["$","h2",null,{"children":"Forms and feedback"}],["$","p",null,{"children":"Web3Forms processes the contact details and message you submit through direct sending and routes the enquiry to info@vertexmodels.ae. We have configured its submission retention to seven days. Copies delivered to our email inbox are retained separately as described below. hCaptcha protects the direct-send flow from spam and may process technical information such as your IP address and browser information. The spam-check service loads when you choose to continue with direct sending. You can instead send from your own email application. Form contents and email addresses are not sent to Google Analytics. A delivery-service acceptance does not guarantee inbox arrival or constitute acceptance of a project. Client feedback is private unless you separately choose to permit website publication of your exact words and selected attribution. We verify and review feedback before publication, and do not display your email address. Contact us to discuss or withdraw publication permission."}],"$L15",false]}],"$L16","$L17","$L18","$L19","$L1a"],"$L1b"]}]]}],"$L1c"]]
15:["$","p",null,{"children":[["$","a",null,{"href":"https://web3forms.com/privacy","target":"_blank","rel":"noopener noreferrer","children":"Web3Forms privacy policy"}]," · ",["$","a",null,{"href":"https://www.hcaptcha.com/privacy","target":"_blank","rel":"noopener noreferrer","children":"hCaptcha privacy policy"}]]}]
1d:T4ed,Google Analytics loads only if you allow analytics in the consent banner. It helps us understand page visits, broad traffic sources, email-button clicks, company-profile views and downloads, and whether a project brief or collaboration introduction was prepared. We also record a submission event when the direct-delivery service accepts an enquiry. Preparing a brief or clicking an email button does not confirm that an enquiry was sent; service acceptance does not confirm inbox arrival. Our tracking code does not send names, email addresses, brief contents, uploaded files, full email links, or URL query strings. Google may process technical information, including your IP address, to provide the service; this should not be understood as completely anonymous tracking. Advertising personalisation and Google signals are disabled. Analytics cookies use the vertex_ga prefix and can last up to 180 days from a visit. Your allow/decline preference is stored on this browser for 180 days. You can change or withdraw permission using Analytics preferences in the footer; withdrawing stops future tracking and removes our analytics cookies on this browser. It does not erase data already processed. Declining does not prevent you from browsing or contacting us.16:["$","section","Optional analytics",{"id":"analytics","children":[["$","span",null,{"className":"terms-number","children":"03"}],["$","h2",null,{"children":"Optional analytics"}],["$","p",null,{"children":"$1d"}],false,["$","p",null,{"children":["$","a",null,{"href":"https://policies.google.com/technologies/partner-sites","target":"_blank","rel":"noopener noreferrer","children":"How Google uses information from sites that use its services ↗"}]}]]}]
17:["$","section","Enquiries and project information",{"id":"$undefined","children":[["$","span",null,{"className":"terms-number","children":"04"}],["$","h2",null,{"children":"Enquiries and project information"}],["$","p",null,{"children":"An email link opens your email application. Sending an enquiry shares the information you choose to include, such as your name, contact details, brief and attachments, with the people handling the enquiry and the email services used to send and receive it. We use that information to respond, prepare a quotation and, if agreed, coordinate the project. For collaboration enquiries, we use your introduction and work examples to assess a potential working relationship and discuss suitable opportunities. We do not use an enquiry as consent to unrelated promotional messages."}],false,false]}]
18:["$","section","Who may receive information",{"id":"$undefined","children":[["$","span",null,{"className":"terms-number","children":"05"}],["$","h2",null,{"children":"Who may receive information"}],["$","p",null,{"children":"Relevant information may be shared with specialist production or delivery partners where needed to prepare or carry out an agreed commission, subject to appropriate confidentiality arrangements. Service providers supporting hosting, email and business administration may process information for those purposes. We may also disclose information where required by law. Service providers may process information in other countries; applicable data-protection requirements still apply."}],false,false]}]
19:["$","section","Retention and protection",{"id":"$undefined","children":[["$","span",null,{"className":"terms-number","children":"06"}],["$","h2",null,{"children":"Retention and protection"}],["$","p",null,{"children":"Information is retained for as long as reasonably needed for the enquiry or project and any applicable record-keeping, dispute or legal obligations. Access should be limited to people who need it for these purposes. No online service or email transmission can be guaranteed completely secure. Before sending highly confidential drawings or sensitive personal information, contact us to agree a suitable transfer method."}],false,false]}]
1a:["$","section","Questions and requests",{"id":"$undefined","children":[["$","span",null,{"className":"terms-number","children":"07"}],["$","h2",null,{"children":"Questions and requests"}],["$","p",null,{"children":"Contact info@vertexmodels.ae about your information or to request access, correction or deletion, subject to applicable law and any necessary identity checks. The person or entity responsible for a commissioned project is identified in its quotation or agreement. This notice does not restrict rights to raise concerns with a competent data-protection authority."}],false,false]}]
